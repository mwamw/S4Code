{
  "name": "s4code-curated-mcp-catalog",
  "generated_at": "2026-04-24",
  "notes": [
    "Copy selected entries into ~/.config/s4code/mcp.json or <project>/.s4code/mcp.json.",
    "All entries are disabled by default so the catalog is safe to keep as a template.",
    "The official modelcontextprotocol reference servers are documented as educational references rather than production-ready services."
  ],
  "servers": [
    {
      "name": "filesystem",
      "enabled": false,
      "server_source": "npx",
      "server_args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/ABS/PATH/TO/WORKSPACE"
      ],
      "tool_prefix": "fs_",
      "include_resources": true,
      "persist_connection": true,
      "tags": ["official", "core", "local"],
      "why": "Safe default for project file access when you need an external MCP filesystem surface.",
      "source_url": "https://github.com/modelcontextprotocol/servers/blob/main/src/filesystem/README.md"
    },
    {
      "name": "git",
      "enabled": false,
      "server_source": "uvx",
      "server_args": [
        "mcp-server-git",
        "--repository",
        "/ABS/PATH/TO/GIT/REPO"
      ],
      "tool_prefix": "git_",
      "include_resources": true,
      "persist_connection": true,
      "tags": ["official", "core", "git"],
      "why": "Adds Git-native operations outside S4Code builtin Git and worktree features.",
      "source_url": "https://github.com/modelcontextprotocol/servers"
    },
    {
      "name": "fetch",
      "enabled": false,
      "server_source": "uvx",
      "server_args": [
        "mcp-server-fetch"
