      "tool_prefix": "fetch_",
      "include_resources": true,
      "persist_connection": true,
      "tags": ["official", "web", "retrieval"],
      "why": "Useful when you want MCP-hosted web fetching instead of builtin web fetch.",
      "source_url": "https://github.com/modelcontextprotocol/servers/blob/main/src/fetch/README.md"
    },
    {
      "name": "memory",
      "enabled": false,
      "server_source": "npx",
