      ],
      "tool_prefix": "memory_",
      "include_resources": true,
      "persist_connection": true,
      "tags": ["official", "memory"],
      "why": "Persistent cross-session memory graph for longer-running agent workflows.",
      "source_url": "https://github.com/modelcontextprotocol/servers"
    },
    {
      "name": "time",
      "enabled": false,
